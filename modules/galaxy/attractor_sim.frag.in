// Harmony Galaxy, Attractor texture: the particle simulation (GLSL TOP in a feedback loop, one pixel = one particle).
// GENERATED by scripts/gen_attractor_glsl.py from attractor_sim.frag.in + tools/attractors.py: edit those.
// Each key area holds an attractor (one per role: tools/attractors.py ROLES). A share of the particles always rides
// home's calm orbit (the memory of home); the rest ride the local key's attractor. When the local key changes
// (uSim.y, the epoch, goes up) the travellers let go, stream toward the new key with a little swirl, and dissolve
// onto its attractor when they arrive. Tension blends a calm laminar orbit into the strange attractor.
// in 0: previous state (xyz = world position, w = epoch it was captured in, -1 = streaming)
// in 1: seeds (x = 4096 points on each attractor, normalised; y = attractor id)
uniform vec4 uHome;    // xyz centre, w attractor id
uniform vec4 uLocal;   // xyz centre, w attractor id
uniform vec4 uSim;     // x tension, y epoch, z size (world radius of an attractor), w share of particles at home
uniform vec4 uStep;    // x time, y substeps, z speed, w reset (1 = put everyone home)
out vec4 fragColor;

const float HSTEP[7] = float[7](/*@HSTEPS*/);

vec3 attractor(int id, vec3 U)
{
//@FIELDS
    return vec3(0.0);
}

vec3 calm(vec3 U)
{
    float r = length(U.xy) + 1e-6;
    float pull = 1.5 * (0.45 - r) / r;
    return vec3(-U.y + pull * U.x, U.x + pull * U.y, -1.5 * U.z);
}

vec3 field(int id, vec3 U, float t)
{
    if (id == 0 && t >= 0.3) t = 1.0;      // Lorenz: calm or fully wild (half-way it sinks into two still points)
    return t * attractor(id, U) + (1.0 - t) * calm(U);
}

float hash(float n) { return fract(sin(n) * 43758.5453123); }

vec3 seedPoint(int id, float h)
{
    // a point on the attractor, nudged a little: particles that share a seed drift apart (chaos does the rest)
    int i = int(h * 4096.0) % 4096;
    vec3 j = vec3(hash(h * 17.1), hash(h * 29.3), hash(h * 41.7)) - 0.5;
    return texelFetch(sTD2DInputs[1], ivec2(i, id), 0).xyz + 0.06 * j;
}

void main()
{
    ivec2 ij = ivec2(gl_FragCoord.xy);
    ivec2 res = textureSize(sTD2DInputs[0], 0);
    float idx = float(ij.y * res.x + ij.x);
    float fi = idx / float(res.x * res.y);
    bool home = fi < uSim.w;
    vec4 st = texelFetch(sTD2DInputs[0], ij, 0);
    vec3 C = home ? uHome.xyz : uLocal.xyz;
    int id = int((home ? uHome.w : uLocal.w) + 0.5);
    float ten = home ? 0.2 : uSim.x;
    float size = uSim.z;
    bool captured = home || abs(st.w - uSim.y) < 0.5;
    vec3 U = (st.xyz - C) / size;
    if (uStep.w > 0.5 || any(isnan(st.xyz))) {          // reset: everyone onto home's attractor
        U = seedPoint(int(uHome.w + 0.5), hash(idx * 1.37 + 0.11));
        C = uHome.xyz;
        captured = home;
    }
    int steps = int(uStep.y + 0.5);
    for (int s = 0; s < steps; s++) {
        float rnd = hash(idx * 12.9898 + uStep.x * 78.233 + float(s) * 3.7);
        if (!captured) {
            float d = length(U);
            if (d < 1.0) {                              // arrived: dissolve onto the attractor
                U = 0.9 * seedPoint(id, rnd);
                captured = true;
            } else {
                vec3 to = -U / d;
                vec3 swirl = vec3(-to.z, 0.0, to.x);
                vec3 n = vec3(hash(rnd * 91.7), hash(rnd * 47.3), hash(rnd * 13.1)) - 0.5;
                U += 0.012 * uStep.z * (2.5 * (to + 0.5 * swirl) + 0.8 * n);
            }
        } else {
            U += uStep.z * HSTEP[id] * field(id, U, ten);
            if (length(U) > 3.5 || any(isnan(U))) U = seedPoint(id, rnd);
        }
    }
    fragColor = vec4(C + U * size, captured ? uSim.y : -1.0);
}
